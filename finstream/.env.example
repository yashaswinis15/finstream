# ----------------------------
# Application (Python / Spark)
# ----------------------------

# PostgreSQL connection (must match Docker credentials below)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintechdb
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Local Delta Lake storage (keep default for local setup)
BRONZE_PATH=/tmp/finstream/delta/bronze/transactions
SILVER_PATH=/tmp/finstream/delta/silver/transactions

# ----------------------------
# Slack (optional)
# ----------------------------
# Paste your Slack webhook URL here (leave empty to disable alerts)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ----------------------------
# Docker Credentials (local development only)
# Must match DB_USER / DB_PASSWORD above
# ----------------------------
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=fintechdb

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin